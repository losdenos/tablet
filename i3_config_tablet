# ~/.config/i3/config — Tablet-optimized i3 config
# Fujitsu Arrows Tab V727 — touchscreen-primary, no permanent keyboard
# Merge this into your existing config or replace it

# ── Mod key: use Super (Windows key) ──────────────────────────────────────
set $mod Mod4

# ── Fonts: larger for touch readability ───────────────────────────────────
font pango:Sans 13

# ── Border: thicker = easier to grab with fingers ─────────────────────────
default_border pixel 3
default_floating_border pixel 3
hide_edge_borders none

# ── Touch-friendly gaps (requires i3-gaps) ────────────────────────────────
# yay -S i3-gaps  (if not already using gaps variant)
gaps inner 8
gaps outer 4

# ── Auto-start services ───────────────────────────────────────────────────
exec --no-startup-id ~/.config/tablet/rotation_daemon.sh
exec --no-startup-id dunst
exec --no-startup-id nm-applet
# Tap-to-click and palm rejection via libinput
exec --no-startup-id xinput set-prop "$(xinput list --name-only | grep -i touch | head -1)" "libinput Tapping Enabled" 1

# ── Status bar (i3status) ─────────────────────────────────────────────────
bar {
    position top
    height 36
    font pango:Sans 12
    status_command i3status
    tray_output primary

    colors {
        background #1e1e2e
        statusline #cdd6f4
        separator  #6c7086

        focused_workspace  #89b4fa #89b4fa #1e1e2e
        active_workspace   #313244 #313244 #cdd6f4
        inactive_workspace #1e1e2e #1e1e2e #6c7086
        urgent_workspace   #f38ba8 #f38ba8 #1e1e2e
    }

    # Tap the bar clock → open dashboard hub
    binding_mode_indicator yes
}

# ── Dashboard hub: swipe up from bottom edge or $mod+space ────────────────
bindsym $mod+space exec ~/.config/tablet/dashboard_hub.sh
bindsym $mod+k     exec ~/.config/tablet/osk_toggle.sh
bindsym $mod+q     exec ~/.config/tablet/quick_controls.sh
bindsym $mod+p     exec ~/.config/tablet/power_menu.sh

# ── Window management (keep essential keyboard shortcuts) ─────────────────
bindsym $mod+Shift+q kill
bindsym $mod+f       fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+r       mode "resize"

# Focus with touch: click window to focus (default i3 behavior is fine)

# ── Resize mode ───────────────────────────────────────────────────────────
mode "resize" {
    bindsym h resize shrink width  40 px
    bindsym l resize grow   width  40 px
    bindsym k resize shrink height 40 px
    bindsym j resize grow   height 40 px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# ── Float certain windows automatically ───────────────────────────────────
for_window [window_role="pop-up"]        floating enable
for_window [window_role="task_dialog"]   floating enable
for_window [class="Nm-connection-editor"] floating enable
for_window [title="Preferences"]        floating enable

# ── Color scheme (Catppuccin Mocha) ───────────────────────────────────────
# class                  border   bg       text     indicator child_border
client.focused           #89b4fa  #1e1e2e  #cdd6f4  #89b4fa   #89b4fa
client.focused_inactive  #313244  #1e1e2e  #6c7086  #313244   #313244
client.unfocused         #1e1e2e  #1e1e2e  #6c7086  #1e1e2e   #1e1e2e
client.urgent            #f38ba8  #1e1e2e  #f38ba8  #f38ba8   #f38ba8
