; ─────────────────────────────────────────────────────────────────
;  CYBERPUNK DESKTOP — eww.yuck
;  Fujitsu Arrows Tab V727 · i3 · 1280×800
;  Install: yay -S eww-x11
; ─────────────────────────────────────────────────────────────────

; ── Polls ─────────────────────────────────────────────────────────
(defpoll time     :interval "1s"  "date '+%H:%M:%S'")
(defpoll date     :interval "60s" "date '+%a %d %b'")
(defpoll cpu      :interval "3s"  "~/.config/eww/scripts/cpu.sh")
(defpoll ram      :interval "3s"  "~/.config/eww/scripts/ram.sh")
(defpoll batt     :interval "10s" "~/.config/eww/scripts/batt.sh")
(defpoll batticon :interval "10s" "~/.config/eww/scripts/batt_icon.sh")
(defpoll vol      :interval "2s"  "pamixer --get-volume")
(defpoll bri      :interval "2s"  "brightnessctl -m | cut -d',' -f4 | tr -d '%'")
(defpoll wifiname :interval "10s" "nmcli -t -f NAME connection show --active | head -1")
(defpoll wifiicon :interval "10s" "~/.config/eww/scripts/wifi_icon.sh")

; ── Main desktop window ───────────────────────────────────────────
(defwindow desktop
  :monitor 0
  :geometry (geometry
    :x "0"
    :y "0"
    :width "1280px"
    :height "800px"
    :anchor "top left")
  :stacking "bg"
  :windowtype "desktop"
  :wm-ignore true
  (desktop-layout))

; ── Root layout ───────────────────────────────────────────────────
(defwidget desktop-layout []
  (box :class "desktop-root"
       :orientation "v"
       :halign "fill"
       :valign "fill"
    (top-bar)
    (box :orientation "h"
         :halign "fill"
         :valign "fill"
         :hexpand true
         :vexpand true
      (left-panel)
      (center-area)
      (right-panel))))

; ── Top bar ───────────────────────────────────────────────────────
(defwidget top-bar []
  (box :class "top-bar"
       :orientation "h"
       :halign "fill"
       :space-evenly false
    (box :class "top-left" :spacing 16 :space-evenly false
      (label :class "sys-tag" :text "SYS//ONLINE")
      (label :class "divider"  :text "│")
      (label :class "wifi-label" :text "${wifiicon}  ${wifiname}"))
    (box :hexpand true)
    (box :class "top-right" :spacing 20 :space-evenly false
      (label :class "batt-label" :text "${batticon}  ${batt}%")
      (label :class "divider"    :text "│")
      (label :class "date-label" :text date)
      (label :class "divider"    :text "│")
      (label :class "time-label" :text time))))

; ── Left panel: app launcher ──────────────────────────────────────
(defwidget left-panel []
  (box :class "left-panel"
       :orientation "v"
       :valign "center"
       :spacing 6
       :space-evenly false
    (label :class "panel-heading" :text "// APPS")
    (app-btn :icon "" :label "BROWSER"  :cmd "firefox")
    (app-btn :icon "" :label "FILES"    :cmd "thunar")
    (app-btn :icon "" :label "TERMINAL" :cmd "alacritty")
    (app-btn :icon "" :label "WRITE"    :cmd "soffice --writer")
    (app-btn :icon "" :label "CALC"     :cmd "soffice --calc")
    (app-btn :icon "󰽉" :label "DRAW"   :cmd "soffice --draw")
    (box :class "panel-sep")
    (label :class "panel-heading" :text "// SYSTEM")
    (app-btn :icon "" :label "KEYBOARD" :cmd "~/.config/tablet/osk_toggle.sh")
    (app-btn :icon "" :label "CONTROLS" :cmd "~/.config/tablet/quick_controls.sh")
    (app-btn :icon "󰐥" :label "POWER"  :cmd "~/.config/tablet/power_menu.sh")))

(defwidget app-btn [icon label cmd]
  (button :class "app-btn"
          :onclick cmd
    (box :orientation "h"
         :spacing 10
         :space-evenly false
      (label :class "app-icon" :text icon)
      (label :class "app-label" :text label))))

; ── Center area: clock + glitch text ─────────────────────────────
(defwidget center-area []
  (box :class "center-area"
       :orientation "v"
       :halign "center"
       :valign "center"
       :spacing 4
       :space-evenly false
    (label :class "glitch-sub" :text "NEURAL INTERFACE v2.0.77")
    (label :class "big-clock"  :text time)
    (label :class "big-date"   :text date)
    (box :class "scan-bar-wrap" :halign "center"
      (box :class "scan-bar"))
    (label :class "glitch-sub2" :text "USER//AUTHENTICATED  ·  LOCATION//ENCRYPTED")))

; ── Right panel: stats ────────────────────────────────────────────
(defwidget right-panel []
  (box :class "right-panel"
       :orientation "v"
       :valign "center"
       :spacing 12
       :space-evenly false
    (label :class "panel-heading" :text "// METRICS")
    (stat-row :label "CPU" :value cpu   :unit "%")
    (stat-bar :value cpu)
    (stat-row :label "RAM" :value ram   :unit "%")
    (stat-bar :value ram)
    (stat-row :label "VOL" :value vol   :unit "%")
    (stat-bar :value vol)
    (stat-row :label "BRI" :value bri   :unit "%")
    (stat-bar :value bri)
    (stat-row :label "BAT" :value batt  :unit "%")
    (stat-bar :value batt)))

(defwidget stat-row [label value unit]
  (box :class "stat-row"
       :orientation "h"
       :space-evenly false
    (label :class "stat-label" :text label)
    (box :hexpand true)
    (label :class "stat-value" :text "${value}${unit}")))

(defwidget stat-bar [value]
  (box :class "stat-bar-bg"
    (box :class "stat-bar-fill"
         :style "min-width: calc(${value} * 1.6px);")))
