/* ~/.config/rofi/cyberpunk.rasi
   Touch-friendly — 1920x1280 tablet
*/

* {
    bg:             #03060f;
    bg-alt:         #080f1e;
    bg-hover:       #0d1a30;
    accent:         #00ffff;
    text:           #cceeff;
    text-dim:       #4d7a99;

    background-color:   transparent;
    text-color:         @text;
}

window {
    background-color:   @bg;
    border:             1px solid;
    border-color:       @accent;
    border-radius:      16px;
    width:              860px;
    padding:            0px;
    location:           center;
    font:               "Sans 15";
}

mainbox {
    background-color:   transparent;
    children:           [ inputbar, listview ];
    spacing:            0px;
    padding:            16px;
}

inputbar {
    background-color:   @bg-alt;
    border-radius:      10px;
    padding:            14px 18px;
    margin:             0px 0px 14px 0px;
    children:           [ prompt, textbox-prompt-colon, entry ];
    spacing:            8px;
}

prompt {
    background-color:   transparent;
    text-color:         @accent;
    font:               "Sans Bold 15";
}

textbox-prompt-colon {
    background-color:   transparent;
    text-color:         @text-dim;
    str:                "›";
    margin:             0px 4px 0px 0px;
}

entry {
    background-color:   transparent;
    text-color:         @text;
    placeholder:        "Search...";
    placeholder-color:  @text-dim;
    cursor:             text;
    font:               "Sans 15";
}

listview {
    background-color:   transparent;
    columns:            3;
    lines:              3;
    spacing:            10px;
    scrollbar:          false;
    layout:             vertical;
    fixed-height:       true;
}

element {
    background-color:   @bg-alt;
    border-radius:      12px;
    border:             1px solid;
    border-color:       @bg-alt;
    padding:            20px 14px;
    orientation:        vertical;
    cursor:             pointer;
    spacing:            10px;
}

element normal.normal {
    background-color:   @bg-alt;
    text-color:         @text;
}

element selected.normal {
    background-color:   @bg-hover;
    border-color:       @accent;
    text-color:         @accent;
}

element-icon {
    size:               48px;
    horizontal-align:   0.5;
    vertical-align:     0.5;
}

element-text {
    horizontal-align:   0.5;
    vertical-align:     0.5;
    text-color:         inherit;
    font:               "Sans 13";
}
